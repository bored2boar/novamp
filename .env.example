# novamp reads. It never signs.
# There is no PRIVATE_KEY setting in this file and no code path that would use one.

# --- network -----------------------------------------------------------------
# Robinhood Chain public RPC. Rate limited: expect 429 on heavy log reads.
# A private provider (Alchemy, QuickNode, Chainstack) makes `scan` and `stats` usable.
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Optional websocket for `watch`. Empty falls back to HTTP polling at POLL_MS.
RPC_WS_URL=
POLL_MS=1500

# Pons V2 factory, from docs.ponsfamily.com/v2.
PONS_V2_FACTORY=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e

# --- indexing ----------------------------------------------------------------
# How far back to look for launches when building a cluster, in blocks.
# Robinhood Chain seals a block roughly every 100 ms, so 400000 blocks is around 11 hours.
INDEX_LOOKBACK_BLOCKS=400000
# eth_getLogs is chunked to stay under public RPC limits.
LOG_CHUNK_BLOCKS=20000
# Max launches pulled into one cluster before novamp stops widening the search.
CLUSTER_MAX_MEMBERS=64

# --- rate limiting -----------------------------------------------------------
RPC_IN_FLIGHT=3
RPC_SPACING_MS=60
RPC_LOGS_SPACING_MS=400

# --- thresholds (every one of these is explained in docs/RULES.md) -----------
# Top-10 holder concentration, excluding the curve and the pool.
RISK_HOLDER_AMBER_PCT=20
RISK_HOLDER_RED_PCT=30
# Deployer share of supply that turns a first-born launch into a suspect.
TAINT_DEV_SHARE_PCT=10
# Wallets declared exempt from the opening tax. This is the declared bundle.
TAINT_EXEMPT_WALLETS=4
# A deployer with this many prior launches and no graduation is a farm.
TAINT_SERIAL_LAUNCHES=5
# Smart wallets buying inside this window count as one convergence event.
CONVERGENCE_WINDOW_SEC=90
CONVERGENCE_MIN_WALLETS=3

# --- narrative feeds (optional, `novamp narrative`) --------------------------
# Comma separated RSS or Atom URLs. Free feeds only; novamp does not ship API keys.
NARRATIVE_FEEDS=
# Extra keywords to keep watching regardless of the feeds.
NARRATIVE_WATCHLIST=

# --- local index -------------------------------------------------------------
# novamp appends what it reads to .novamp/ so `--since 7d` and `--since 30d` mean
# something. Nothing is sent anywhere; deleting the directory is safe and costs
# only the history. Demo runs never write to it.

# --- alerts (optional, `novamp watchlist run`) -------------------------------
# A bot token can post messages to your chat. That is all it can do: novamp has
# no webhook, no command handler and nothing on the other end that could ask it
# to act.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- board -------------------------------------------------------------------
# `novamp board` binds 127.0.0.1 only, never 0.0.0.0.
BOARD_PORT=4663

# --- output ------------------------------------------------------------------
# Set to 1 to drop ANSI colour, for piping into a file.
NO_COLOR=
